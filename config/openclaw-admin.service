[Unit]
Description=Yoma+HR Admin Portal
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/yomajiahr/admin-server
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=10
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=TMPDIR=/run/user/1000
Environment=ADMIN_PORTAL_PORT=18790
Environment=OPENCLAW_STATE_DIR=/home/ubuntu/.openclaw
EnvironmentFile=/home/ubuntu/.openclaw/.env

[Install]
WantedBy=multi-user.target
