// Yoma+HR 智能助手 — 配置文件
// 使用方法: 写入 ~/.ymjhr/ymjhr.json（通过 OPENCLAW_CONFIG_PATH 指定）
{
  "web": {
    "enabled": true,
  },

  // ---------------------------------------------------------------------------
  // Channels
  // ---------------------------------------------------------------------------
  "channels": {
    // 飞书 (Phase 1: Bot 1 全员 + Bot 4 管理员)
    "feishu": {
      "enabled": true,
      "domain": "feishu",
      "connectionMode": "websocket",
      "accounts": {
        // Bot 1: HR小助手 — 全员可用
        "hr-assistant": {
          "appId": "${FEISHU_HR_BOT_APP_ID}",
          "appSecret": { "source": "env", "id": "FEISHU_HR_BOT_APP_SECRET" },
          "botName": "HR小助手",
          "enabled": true,
        },
        // Bot 4: HR管理后台 — 仅 HR 管理员
        "hr-admin": {
          "appId": "${FEISHU_ADMIN_BOT_APP_ID}",
          "appSecret": { "source": "env", "id": "FEISHU_ADMIN_BOT_APP_SECRET" },
          "botName": "HR管理后台",
          "enabled": true,
        },
        // Phase 2+: 取消注释以启用
        // "hr-recruit": {
        //   "appId": "${FEISHU_RECRUIT_BOT_APP_ID}",
        //   "appSecret": { "source": "env", "id": "FEISHU_RECRUIT_BOT_APP_SECRET" },
        //   "botName": "招聘助手",
        //   "enabled": true
        // },
        // "hr-analytics": {
        //   "appId": "${FEISHU_ANALYTICS_BOT_APP_ID}",
        //   "appSecret": { "source": "env", "id": "FEISHU_ANALYTICS_BOT_APP_SECRET" },
        //   "botName": "HR数据分析师",
        //   "enabled": true
        // }
      },
      "dmPolicy": "open",
      "groupPolicy": "open",
      "streaming": true,
    },
  },

  // ---------------------------------------------------------------------------
  // Agents
  // ---------------------------------------------------------------------------
  "agents": {
    "defaults": {
      // 将默认 agent workspace 显式固定到运行时状态目录，便于服务器排查和备份。
      "workspace": "~/.ymjhr/workspace",
      "model": {
        // 当前默认使用 MiniMax 国内站；后续可在 fallbacks 中追加其他 provider/model。
        "primary": "minimax/MiniMax-M2.7",
        // "fallbacks": ["openai/gpt-5.1", "anthropic/claude-sonnet-4-5"],
      },
      "subagents": {
        "maxSpawnDepth": 2, // orchestrator → sub-agent → worker
        "maxChildrenPerAgent": 5,
        "maxConcurrent": 8,
        "runTimeoutSeconds": 300, // 5 min timeout
      },
    },
    "list": [
      {
        "id": "hr-assistant",
        "name": "HR小助手",
        "skills": ["hr-assistant"],
        "subagents": {
          "allowAgents": ["hr-policy-rag", "hr-onboard", "hr-schedule"],
        },
      },
      {
        "id": "hr-policy-rag",
        "name": "政策问答",
        "skills": ["hr-policy-rag"],
      },
      {
        "id": "hr-admin",
        "name": "HR管理后台",
        "skills": ["hr-admin"],
      },
    ],
  },

  // ---------------------------------------------------------------------------
  // Models
  // ---------------------------------------------------------------------------
  "models": {
    // 保持 merge，便于后续继续接入 OpenAI / Anthropic / OpenRouter 等其他 provider。
    "mode": "merge",
    "providers": {
      "minimax": {
        // MiniMax 国内 Anthropic 兼容入口。显式写死可避免自动注入回落到全球域名。
        "baseUrl": "https://api.minimaxi.com/anthropic",
        "api": "anthropic-messages",
        "authHeader": true,
        "apiKey": "${MINIMAX_API_KEY}",
      },
    },
  },

  // ---------------------------------------------------------------------------
  // Tool policies (sub-agent 工具权限)
  // ---------------------------------------------------------------------------
  "tools": {
    "subagents": {
      "tools": {
        "deny": ["gateway", "cron", "sessions_send"],
      },
    },
  },
}
