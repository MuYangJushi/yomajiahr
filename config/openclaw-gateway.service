[Unit]
Description=Yoma+HR Gateway
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/yomajiahr/current
ExecStart=/usr/bin/env openclaw gateway run --bind loopback --port 18789 --force
Restart=always
RestartSec=10
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=TMPDIR=/run/user/1000
Environment=OPENCLAW_CONFIG_PATH=/home/ubuntu/.openclaw/openclaw.json
EnvironmentFile=/home/ubuntu/.openclaw/.env

[Install]
WantedBy=multi-user.target
