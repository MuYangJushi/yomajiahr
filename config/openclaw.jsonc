// Yoma+HR 智能助手 — 配置文件
// 使用方法: 写入 ~/.openclaw/openclaw.json（openclaw 默认路径）
{
  "web": {
    "enabled": true,
  },

  // ---------------------------------------------------------------------------
  // Channels
  // ---------------------------------------------------------------------------
  "channels": {
    // 飞书 (Phase 1: Bot 1 全员 + Bot 4 管理员)
    "feishu": {
      "enabled": true,
      "domain": "feishu",
      "connectionMode": "websocket",
      "accounts": {
        // Bot 1: HR小助手 — 全员可用
        "hr-assistant": {
          "appId": "${FEISHU_HR_BOT_APP_ID}",
          "appSecret": "${FEISHU_HR_BOT_APP_SECRET}",
          "dmPolicy": "open",
          "groupPolicy": "open",
        },
        // Bot 4: HR管理后台 — 仅 HR 管理员（allowlist 限制，防止普通员工触达）
        "hr-admin": {
          "appId": "${FEISHU_ADMIN_BOT_APP_ID}",
          "appSecret": "${FEISHU_ADMIN_BOT_APP_SECRET}",
          "dmPolicy": "allowlist",
          "allowFrom": ["ou_32a9dfe89fffb8c0995e7583bdc5a86f", "ou_fd4b9db98288eeabde7974cbb423189f"],
          "groupPolicy": "disabled",
        },
        // Phase 2+: 取消注释以启用
        // "hr-recruit": {
        //   "appId": "${FEISHU_RECRUIT_BOT_APP_ID}",
        //   "appSecret": "${FEISHU_RECRUIT_BOT_APP_SECRET}",
        // },
        // "hr-analytics": {
        //   "appId": "${FEISHU_ANALYTICS_BOT_APP_ID}",
        //   "appSecret": "${FEISHU_ANALYTICS_BOT_APP_SECRET}",
        // }
      },
      "streaming": true,
    },
  },

  // ---------------------------------------------------------------------------
  // Agents
  // ---------------------------------------------------------------------------
  "agents": {
    "defaults": {
      "model": {
        // 当前默认使用 MiniMax 国内站；后续可在 fallbacks 中追加其他 provider/model。
        "primary": "minimax/MiniMax-M2.7",
        // "fallbacks": ["openai/gpt-5.1", "anthropic/claude-sonnet-4-5"],
      },
    },
    "list": [
      {
        "id": "hr-assistant",
        "name": "HR小助手",
        "workspace": "~/.openclaw/workspaces/hr-assistant",
        "skills": ["hr-policy-qa", "hr-general"],
        // 阿里百炼 Embedding（通过 OpenAI-compatible /embeddings 接口接入）

        "memorySearch": {
          "enabled": true,
          "sources": ["memory"],
          "experimental": {
            "sessionMemory": false,
          },
          "provider": "openai",
          "model": "text-embedding-v4",
          "fallback": "none",
          "remote": {
            "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
            "apiKey": "${DASHSCOPE_API_KEY}",
          },
          "sync": {
            "watch": true,
            "onSessionStart": true,
          },
          "query": {
            "hybrid": {
              "enabled": true,
            },
          },
          "extraPaths": ["../../data/hr-policies"],
        },
        "tools": {
          "deny": ["memory_write", "memory_delete", "exec"],
        },
      },
      {
        "id": "hr-admin",
        "name": "HR管理后台",
        "workspace": "~/.openclaw/workspaces/hr-admin",
        "skills": ["hr-admin"],

        "memorySearch": {
          "enabled": true,
          "sources": ["memory"],
          "experimental": {
            "sessionMemory": false,
          },
          "provider": "openai",
          "model": "text-embedding-v4",
          "fallback": "none",
          "remote": {
            "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
            "apiKey": "${DASHSCOPE_API_KEY}",
          },
          "sync": {
            "watch": true,
            "onSessionStart": true,
          },
          "query": {
            "hybrid": {
              "enabled": true,
            },
          },
          "extraPaths": ["../../data/hr-policies"],
        },
      },
    ],
  },

  // ---------------------------------------------------------------------------
  // Session 管理（可选项，默认全局单会话） — 这里示例按账号-频道-对话对象维度隔离会话，并每天凌晨重置一次
  // ---------------------------------------------------------------------------
  "session": {
  "dmScope": "per-account-channel-peer",
  "reset": {
    "mode": "daily",
    "atHour": 6,
    },
  },

  // ---------------------------------------------------------------------------
  // Bindings
  // ---------------------------------------------------------------------------
  "bindings": [
    {
      "agentId": "hr-assistant",
      "match": {
        "channel": "feishu",
        "accountId": "hr-assistant",
      },
    },
    {
      "agentId": "hr-admin",
      "match": {
        "channel": "feishu",
        "accountId": "hr-admin",
      },
    },
  ],

  // ---------------------------------------------------------------------------
  // Models
  // ---------------------------------------------------------------------------
  "models": {
    // 保持 merge，便于后续继续接入 OpenAI / Anthropic / OpenRouter 等其他 provider。
    "mode": "merge",
    "providers": {
      "minimax": {
        // MiniMax 国内 Anthropic 兼容入口。显式写死可避免自动注入回落到全球域名。
        "baseUrl": "https://api.minimaxi.com/anthropic",
        "api": "anthropic-messages",
        "authHeader": true,
        "apiKey": "${MINIMAX_API_KEY}",
        // 保留空数组以通过 schema 校验，实际模型目录仍由 MiniMax 插件补全。
        "models": [],
      },
    },
  },
}
