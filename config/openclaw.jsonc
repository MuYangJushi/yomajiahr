// Yoma+HR 智能助手 — 配置文件
// 使用方法: 写入 ~/.openclaw/openclaw.json（openclaw 默认路径）
{
  "web": {
    "enabled": true,
  },

  // 非内置渠道插件需要显式信任/启用，gateway 启动时才会加载 runtime。
  "plugins": {
    "bundledDiscovery": "compat",
    "allow": ["dingtalk-connector", "openclaw-lark"],
    "entries": {
      "dingtalk-connector": {
        "enabled": true,
      },
      "openclaw-lark": {
        "enabled": true,
      },
    },
  },

  // ---------------------------------------------------------------------------
  // Channels
  // ---------------------------------------------------------------------------
  "channels": {
    // 飞书 (Bot 1 全员 + Bot 4 管理员)
    "feishu": {
      "enabled": true,
      "domain": "feishu",
      "connectionMode": "websocket",
      "accounts": {
        // Bot 1: HR小助手 — 全员可用
        "hr-assistant": {
          "appId": "${FEISHU_HR_BOT_APP_ID}",
          "appSecret": "${FEISHU_HR_BOT_APP_SECRET}",
          "dmPolicy": "open",
          "groupPolicy": "open",
          "requireMention": true,
        },
        // Bot 4: HR管理后台 — 仅 HR 管理员
        // 已知风险: dmPolicy 为 open，任何知道 Bot ID 的员工均可 DM。
        // 待后续确认 openclaw 是否支持 allowlist 字段后补全访问限制。
        "hr-admin": {
          "appId": "${FEISHU_ADMIN_BOT_APP_ID}",
          "appSecret": "${FEISHU_ADMIN_BOT_APP_SECRET}",
          "dmPolicy": "open",
          "groupPolicy": "disabled",
        },
        // Phase 2+: 取消注释以启用
        // "hr-recruit": {
        //   "appId": "${FEISHU_RECRUIT_BOT_APP_ID}",
        //   "appSecret": "${FEISHU_RECRUIT_BOT_APP_SECRET}",
        // },
        // "hr-analytics": {
        //   "appId": "${FEISHU_ANALYTICS_BOT_APP_ID}",
        //   "appSecret": "${FEISHU_ANALYTICS_BOT_APP_SECRET}",
        // }
      },
      "streaming": true,
    },

    // 钉钉 (双入口镜像: HR小助手 + HR管理后台)
    // 使用钉钉官方 connector: @dingtalk-real-ai/dingtalk-connector
    // 钉钉开放平台需创建企业内部应用机器人，并将消息接收模式设为 Stream 模式。
    "dingtalk-connector": {
      "enabled": true,
      "accounts": {
        // HR小助手 — 全员可用
        "hr-assistant": {
          "enabled": true,
          "name": "HR小助手",
          "clientId": "${DINGTALK_HR_BOT_CLIENT_ID}",
          "clientSecret": "${DINGTALK_HR_BOT_CLIENT_SECRET}",
          "dmPolicy": "open",
          "groupPolicy": "open",
          "requireMention": true,
        },
        // HR管理后台 — 仅 HR 管理员
        // 管理入口依赖钉钉应用可见范围做第一道隔离，agent tools.deny 做第二道隔离。
        "hr-admin": {
          "enabled": true,
          "name": "HR管理后台",
          "clientId": "${DINGTALK_ADMIN_BOT_CLIENT_ID}",
          "clientSecret": "${DINGTALK_ADMIN_BOT_CLIENT_SECRET}",
          "dmPolicy": "open",
          "groupPolicy": "disabled",
        },
      },
      "tools": {
        "docs": false,
        "media": false,
      },
      "groupReplyMode": "markdown",
    },
  },

  // ---------------------------------------------------------------------------
  // Agents
  // ---------------------------------------------------------------------------
  "agents": {
    "defaults": {
      "model": {
        // 当前默认使用 MiniMax 国内站；MiniMax 为单点 provider，建议接入第二家后启用 fallbacks。
        "primary": "minimax/MiniMax-M2.7",
        // "fallbacks": ["openai/gpt-5.1", "anthropic/claude-sonnet-4-5"],
      },
      // 心跳默认每 30 分钟执行一次，但默认不向聊天渠道外发，仅用于内部巡检与保活。
      // 各 agent 需显式声明 heartbeat 才会启用，避免依赖 “默认 agent” 的隐式规则。
      "heartbeat": {
        "every": "30m",
        "target": "none",
      },
      // 阿里百炼 Embedding（通过 OpenAI-compatible /embeddings 接口接入）。
      // 两个 agent 配置完全相同，统一在此管理。
      // 注意: hr-assistant 可检索 compensation/（受限级）目录；
      //       当前依赖 hr-policy-qa skill 行为约束拦截，待确认 excludePaths 支持后在配置层补全隔离。
      "memorySearch": {
        "enabled": true,
        "sources": ["memory"],
        "experimental": {
          "sessionMemory": false,
        },
        "provider": "openai",
        "model": "text-embedding-v4",
        "fallback": "none",
        "remote": {
          "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "apiKey": "${DASHSCOPE_API_KEY}",
        },
        "sync": {
          "watch": true,
          "onSessionStart": true,
        },
        "query": {
          "hybrid": {
            "enabled": true,
          },
        },
        "extraPaths": ["../../data/hr-chunks"],
        // 预切片文件已按主题切好，调大窗口让每个 .md = 一个 chunk，避免 builtin 二次切片
        "chunking": {
          "tokens": 4000,
          "overlap": 0,
        },
      },
    },
    "list": [
      {
        "id": "hr-assistant",
        "default": true,
        "name": "HR小助手",
        "workspace": "~/.openclaw/workspaces/hr-assistant",
        "skills": ["hr-policy-qa", "hr-general"],
        "heartbeat": {},
        "tools": {
          // 使用 allowlist 防止钉钉 connector 的文档/日历/待办/DING 等额外工具默认暴露给员工入口。
          "allow": ["memory_search", "memory_get"],
          "deny": ["memory_write", "memory_delete", "exec"],
        },
      },
      {
        "id": "hr-admin",
        "name": "HR管理后台",
        "workspace": "~/.openclaw/workspaces/hr-admin",
        "skills": ["hr-admin"],
        "heartbeat": {},
        "tools": {
          // 管理员入口只开放 HR 知识库管理所需工具；钉钉额外业务工具默认不授权。
          "allow": ["memory_search", "memory_get", "memory_write", "memory_delete", "exec"],
          "deny": ["gateway", "sessions_spawn"],
        },
      },
    ],
  },

  // ---------------------------------------------------------------------------
  // Session 管理（可选项，默认全局单会话）— 按账号-频道-对话对象维度隔离，每天凌晨重置
  // ---------------------------------------------------------------------------
  "session": {
    "dmScope": "per-account-channel-peer",
    "reset": {
      "mode": "daily",
      "atHour": 6,
    },
  },

  // ---------------------------------------------------------------------------
  // Bindings
  // ---------------------------------------------------------------------------
  "bindings": [
    {
      "agentId": "hr-assistant",
      "match": {
        "channel": "feishu",
        "accountId": "hr-assistant",
      },
    },
    {
      "agentId": "hr-admin",
      "match": {
        "channel": "feishu",
        "accountId": "hr-admin",
      },
    },
    {
      "agentId": "hr-assistant",
      "match": {
        "channel": "dingtalk-connector",
        "accountId": "hr-assistant",
      },
    },
    {
      "agentId": "hr-admin",
      "match": {
        "channel": "dingtalk-connector",
        "accountId": "hr-admin",
      },
    },
  ],

  // ---------------------------------------------------------------------------
  // Models
  // ---------------------------------------------------------------------------
  "models": {
    // 保持 merge，便于后续继续接入 OpenAI / Anthropic / OpenRouter 等其他 provider。
    "mode": "merge",
    "providers": {
      "minimax": {
        // MiniMax 国内 Anthropic 兼容入口。显式写死可避免自动注入回落到全球域名。
        "baseUrl": "https://api.minimaxi.com/anthropic",
        "api": "anthropic-messages",
        "authHeader": true,
        "apiKey": "${MINIMAX_API_KEY}",
        // 保留空数组以通过 schema 校验，实际模型目录仍由 MiniMax 插件补全。
        "models": [],
      },
    },
  },
}
