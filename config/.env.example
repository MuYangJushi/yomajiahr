# HR 智能助手 — 环境变量模板
#
# 使用方法:
# 1. 复制本文件为 .env（本地开发）或 ~/.openclaw/.env（生产部署）
# 2. 填写实际值
# 3. 不要将 .env 提交到 git

# -----------------------------------------------------------------------------
# Model provider (至少配一个)
# -----------------------------------------------------------------------------
# MiniMax 国内站（推荐当前部署）
# `MINIMAX_API_KEY` 用于实际模型调用；如果你有单独的 Coding Plan key，可一并填写
# `MINIMAX_CODE_PLAN_KEY` 供用量/额度查询优先使用。
MINIMAX_API_KEY=sk-...
# MINIMAX_CODE_PLAN_KEY=sk-...

# HR 政策知识库 embedding（供 hr-assistant 做政策知识库语义检索）
# 当前模板默认使用阿里百炼 Embedding，走 OpenAI-compatible 接口。
DASHSCOPE_API_KEY=sk-...

# 其他 provider（按需启用；如果未来加主模型 fallback，可在这里继续补）
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Gateway
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# -----------------------------------------------------------------------------
# 飞书 Bot 1: HR小助手 (全员)
# 在飞书开放平台创建自建应用，获取 App ID 和 App Secret
# 需要权限: im:message, im:message:send, im:resource, contact:user.id:readonly
# 事件订阅: im.message.receive_v1
# 连接方式: WebSocket
# -----------------------------------------------------------------------------
FEISHU_HR_BOT_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_HR_BOT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 飞书 Bot 4: HR管理后台 (HR管理员)
# 飞书可见范围: 仅 HR 管理员
# -----------------------------------------------------------------------------
FEISHU_ADMIN_BOT_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_ADMIN_BOT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 钉钉 Bot 1: HR小助手 (全员)
# 在钉钉开放平台创建企业内部应用机器人，获取 AppKey(Client ID) 和 AppSecret
# 消息接收模式: Stream 模式
# v1 仅申请消息收发所需权限，不启用钉钉文档/日历/待办/DING 等额外能力
# -----------------------------------------------------------------------------
DINGTALK_HR_BOT_CLIENT_ID=dingxxxxxxxxxxxxxxxx
DINGTALK_HR_BOT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 钉钉 Bot 4: HR管理后台 (HR管理员)
# 钉钉应用可见范围: 仅 HR 管理员
# -----------------------------------------------------------------------------
DINGTALK_ADMIN_BOT_CLIENT_ID=dingxxxxxxxxxxxxxxxx
DINGTALK_ADMIN_BOT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Web Portal (管理员后台)
# -----------------------------------------------------------------------------
# 机器/服务 token（决策六后语义收窄为"机器/应急通道"，非人类登录主路径）。
# 不配置则该路径关闭；配置后默认能力档：SESSION_SECRET 已设时为 ops，未设时回落 admin（兼容旧部署）。
OPENCLAW_WEB_AUTH_TOKEN=change-me-to-a-long-random-token
# 显式指定机器 token 能力档（admin|ops|audit），覆盖上面的默认推断。
# OPENCLAW_WEB_AUTH_TOKEN_ROLE=ops

# -----------------------------------------------------------------------------
# 平台认证 / RBAC（决策六：飞书/钉钉双 IdP 登录）
# -----------------------------------------------------------------------------
# 平台 session 签名密钥（强随机）。未配置则 IdP 登录禁用，回落 token/localhost。
SESSION_SECRET=change-me-to-a-long-random-secret
# session 有效期（秒），默认 12 小时
# ADMIN_PORTAL_SESSION_MAX_AGE_SEC=43200
# 飞书"网页登录"应用凭据（可单开应用；缺省复用 FEISHU_ADMIN_BOT_APP_ID/SECRET）
# FEISHU_LOGIN_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_LOGIN_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OAuth 回调基址（公网可达，OAuth 回调与 Secure cookie 需 HTTPS）
# ADMIN_PORTAL_PUBLIC_URL=https://portal.example.com
# 飞书 API 地址（token/user_info），默认国内站 https://open.feishu.cn
# FEISHU_OPEN_BASE=https://open.feishu.cn
# 飞书 OAuth 授权域名（与 API 域名不同！默认 https://accounts.feishu.cn）
# FEISHU_ACCOUNTS_BASE=https://accounts.feishu.cn
# 授权 scope（空格分隔）。② 跨家身份归一化需手机号/邮箱时填：
#   contact:user.phone:readonly contact:user.email:readonly ；① 仅 union_id 可留空
# FEISHU_LOGIN_SCOPE=
# 钉钉"网页登录"应用凭据（可单开应用；缺省复用 DINGTALK_ADMIN_BOT_CLIENT_ID/SECRET）
# DINGTALK_LOGIN_CLIENT_ID=dingxxxxxxxxxxxxxxxx
# DINGTALK_LOGIN_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 钉钉 OAuth 授权域名（登录页）/ API 地址（换 token、取用户信息），默认即官方域名
# DINGTALK_LOGIN_BASE=https://login.dingtalk.com
# DINGTALK_API_BASE=https://api.dingtalk.com
# 钉钉授权 scope，默认 openid（手机号/邮箱由应用「个人信息」权限决定，非 scope）
# DINGTALK_LOGIN_SCOPE=openid
# 引导管理员名单（解决首个 admin 鸡生蛋）：逗号分隔的手机号或飞书/钉钉 unionId
# PLATFORM_BOOTSTRAP_ADMINS=13800000000,on_xxxxxxxxxxxx
# 比赛展示临时开放：让任意完成飞书/钉钉 OAuth 认证的账号进入，赋予 ops 或 audit。
# 未设置即关闭；admin 会被拒绝为非法配置。ops 可展示主体内容，但也具备上传/删除等操作权限，
# 仅在隔离的演示环境短期开启，比赛结束后立即删除并重启服务。
# PLATFORM_DEMO_OPEN_LOGIN_ROLE=ops
# 比赛访问码登录：绕过企业 IdP 的可用范围限制，供外部评委/体验用户使用。
# 访问码至少 16 字符；角色只允许 ops/audit；比赛结束后删除并轮转 SESSION_SECRET。
# PLATFORM_DEMO_ACCESS_CODE=replace-with-at-least-16-random-characters
# PLATFORM_DEMO_ACCESS_ROLE=ops
# 开发兜底：置 1 时 localhost 无凭据按 admin 放行（生产务必关闭/不设）
# ADMIN_PORTAL_DEV_LOCALHOST_ADMIN=1

# -----------------------------------------------------------------------------
# 知识库平台（ADR-006 / FastGPT 集成）
# KNOWLEDGE_PLATFORM=local 时使用现状本地链路（doc-chunker + memory_search）；
# 设为 fastgpt 并填齐下列变量后，admin-server 走 FastGPT。任一缺失则自动回退本地。
# FastGPT 部署在单独机器，仅绑定 loopback/WireGuard；admin-server 经 WireGuard IP 访问，
# 浏览器与员工 Agent 都不直连 FastGPT（含受限薪酬，绝不公网裸暴露）。
# -----------------------------------------------------------------------------
KNOWLEDGE_PLATFORM=local
# FASTGPT_BASE_URL=http://10.99.0.1:3000
# FASTGPT_API_KEY=fastgpt-xxxxxxxxxxxxxxxx
# FASTGPT_KB_ID=replace-with-dataset-id
# FASTGPT_EMBEDDING_MODEL=text-embedding-v4
# MCP 端点 /mcp 的 Bearer 令牌（架构 I：openclaw 经 `mcp add --header` 调 knowledge_search）。
# 部署后生成强随机值、与 OPENCLAW_WEB_AUTH_TOKEN 不同；空值时 /mcp 拒绝全部请求（fail-closed）。
KNOWLEDGE_MCP_TOKEN=

# -----------------------------------------------------------------------------
# Phase 2+ (暂不需要)
# -----------------------------------------------------------------------------
# FEISHU_RECRUIT_BOT_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_RECRUIT_BOT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_ANALYTICS_BOT_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_ANALYTICS_BOT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
