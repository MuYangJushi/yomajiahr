# HR 智能助手 — 环境变量模板
#
# 使用方法:
# 1. 复制本文件为 .env（本地开发）或 ~/.ymjhr/.env（生产部署）
# 2. 填写实际值
# 3. 不要将 .env 提交到 git

# -----------------------------------------------------------------------------
# Model provider (至少配一个)
# -----------------------------------------------------------------------------
# MiniMax 国内站（推荐当前部署）
# `MINIMAX_API_KEY` 用于实际模型调用；如果你有单独的 Coding Plan key，可一并填写
# `MINIMAX_CODE_PLAN_KEY` 供用量/额度查询优先使用。
MINIMAX_API_KEY=sk-...
# MINIMAX_CODE_PLAN_KEY=sk-...

# HR 政策知识库 embedding（当前模板默认必填，供 hr-policy-rag 做语义检索）
# 当前模板默认使用阿里百炼 Embedding，走 OpenAI-compatible 接口。
DASHSCOPE_API_KEY=sk-...

# 其他 provider（按需启用；如果未来加主模型 fallback，可在这里继续补）
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Gateway
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# -----------------------------------------------------------------------------
# 飞书 Bot 1: HR小助手 (全员)
# 在飞书开放平台创建自建应用，获取 App ID 和 App Secret
# 需要权限: im:message, im:message:send, im:resource, contact:user.id:readonly
# 事件订阅: im.message.receive_v1
# 连接方式: WebSocket
# -----------------------------------------------------------------------------
FEISHU_HR_BOT_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_HR_BOT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 飞书 Bot 4: HR管理后台 (HR管理员)
# 飞书可见范围: 仅 HR 管理员
# -----------------------------------------------------------------------------
FEISHU_ADMIN_BOT_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_ADMIN_BOT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Web Portal (管理员后台)
# 用于 Web Provider 的 token 认证
# -----------------------------------------------------------------------------
OPENCLAW_WEB_AUTH_TOKEN=change-me-to-a-long-random-token

# -----------------------------------------------------------------------------
# Phase 2+ (暂不需要)
# -----------------------------------------------------------------------------
# FEISHU_RECRUIT_BOT_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_RECRUIT_BOT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_ANALYTICS_BOT_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_ANALYTICS_BOT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
