{
  "name": "hr-admin-server",
  "version": "1.0.0",
  "private": true,
  "description": "HR Admin Portal - document management, audit log viewer, agent config",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsup --watch --onSuccess \"node dist/server.js\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mammoth": "^1.9.0",
    "multer": "^2.0.1",
    "pdfjs-dist": "^5.5.207"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
